# Copy to .env.local for local development, and set the same names in
# Vercel > Project Settings > Environment Variables for production.

# Signs login cookies. Required in production, at least 32 characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Supabase (Dashboard > Project Settings > API). Required in production.
# Without these, development falls back to data/db.json (demo data).
# The service role key is a server secret: never prefix it with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public address of the site, used for canonical URLs, the sitemap and
# structured data. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://illyjobs.ng

# Local demos only: lets the pricing page upgrade to Pro without payment.
# Ignored in production.
# ALLOW_UNPAID_UPGRADES=true
